# ===== Board: ESP32-S3 N16R8 (flash 16MB quad, PSRAM 8MB octal) =====
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Kode & rodata TETAP di flash/cache (bukan PSRAM): jalur audio deterministik
# CONFIG_SPIRAM_FETCH_INSTRUCTIONS is not set
# CONFIG_SPIRAM_RODATA is not set
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y

# ===== Wajib untuk Arduino sebagai komponen IDF =====
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ARDUINO_RUN_CORE1=y
CONFIG_ARDUINO_EVENT_RUN_CORE1=y
CONFIG_ARDUINO_UDP_RUN_CORE1=y

# ===== Core 0 = DSP saja, semua lainnya ke core 1 =====
CONFIG_ESP32_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
# Idle task core 0 tidak perlu diawasi WDT (DSP boleh sibuk)
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set

# ===== Setara build Arduino murni (yang dulu dipakai) =====
# WebSocket di esp_http_server (default IDF = mati) -> dlms_ws.cpp
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_COMPILER_CXX_EXCEPTIONS=y
